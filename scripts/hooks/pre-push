#!/bin/sh
# Second line of defence: checks the full tree of every pushed commit, so a
# commit made with --no-verify cannot publish a non-public world either.
check="$(git rev-parse --show-toplevel)/scripts/hooks/check-worlds.sh"
zero=0000000000000000000000000000000000000000
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue
  if [ "$remote_sha" = "$zero" ]; then range="$local_sha"; else range="$remote_sha..$local_sha"; fi
  for commit in $(git rev-list "$range"); do
    git ls-tree -r --name-only "$commit" -- characters | sh "$check" || { echo "(found in commit $commit)" >&2; exit 1; }
  done
done
exit 0
